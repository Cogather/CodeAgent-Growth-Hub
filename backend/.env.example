# 复制为 .env 后按本机 MySQL 修改；生产环境可只改 DATABASE_URL 一行
# cp .env.example .env

# 方式一（推荐生产）：完整连接串，设置后忽略下方 MYSQL_* 分项
# DATABASE_URL=mysql+pymysql://user:password@host:3306/codeagent_growth_hub?charset=utf8mb4

# 方式二（推荐本地）：分项配置，程序会自动拼连接串并创建库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=codeagent_growth_hub

# 鉴权（生产环境务必修改 JWT_SECRET_KEY，并设置 COOKIE_SECURE=true）
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=8
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HR 工号查询（内网 GET）。未配置时批量导入仍使用内置 Mock 数据。
# 示例：http://10.0.0.1/hr/api/employee?info=  （程序在 info= 后拼接工号）
# 也可只配基础路径，程序会自动追加 ?info=工号
HR_LOOKUP_URL=
HR_LOOKUP_TIMEOUT_SECONDS=10
