# 复制为 .env 后按本机 MySQL 修改；生产环境可只改 DATABASE_URL 一行
# cp .env.example .env

# 方式一（推荐生产）：完整连接串，设置后忽略下方 MYSQL_* 分项
# DATABASE_URL=mysql+pymysql://user:password@host:3306/codeagent_growth_hub?charset=utf8mb4

# 方式二（推荐本地）：分项配置，程序会自动拼连接串并创建库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=codeagent_growth_hub
